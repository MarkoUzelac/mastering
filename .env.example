NODE_ENV=production
PORT=3000
APP_URL=https://masteringlocal.pro
ALLOWED_ORIGINS=https://masteringlocal.pro
SESSION_SIGNING_SECRET=

# Firebase Admin / Firestore is server-side only and remains required for persistent accounts, billing state and privacy requests.
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe live configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Gemini server-side configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Legal identity - required in production
LEGAL_BUSINESS_ADDRESS=
LEGAL_BUSINESS_COUNTRY=Croatia
LEGAL_BUSINESS_NAME=
LEGAL_GOVERNING_LAW=
LEGAL_PRIVACY_EMAIL=
LEGAL_REGISTRATION_NUMBER=
LEGAL_SUPPORT_EMAIL=
LEGAL_VAT_ID=
