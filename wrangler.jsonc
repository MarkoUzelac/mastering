{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masteringlocal-pro",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "MasteringContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 1024,
        "disk_mb": 4000
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MASTERING_CONTAINER",
        "class_name": "MasteringContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MasteringContainer"]
    }
  ]
}
